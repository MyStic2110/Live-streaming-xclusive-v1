# Project-wide environment variables (can be used as fallback or consolidated configuration)
# Copy this to .env at the root of the project to load globally.

# LiveKit Configuration
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# OpenRouter / LLM Config
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ENABLE_LLM_TRACING=false

# Shoppe agent — structured price comparison (optional).
# When set, SHOPPE fetches real per-merchant prices (SerpAPI Google Shopping, gl=in)
# and reports the genuine cheapest store. Without it, Shoppe falls back to the
# live browser scrape (no reliable price comparison). NOTE: the Shoppe worker reads
# python-agent/.env, so put SERPAPI_KEY there for the agent at runtime.
SERPAPI_KEY=your_serpapi_key_here

# Swarm Copilot — Mem0 long-term memory vector store.
# Point Mem0 at the Qdrant SERVER (docker-compose service `qdrant`) so the Node
# copilot bridge and the in-process agent can access memories concurrently.
# If UNSET, Mem0 falls back to embedded on-disk Qdrant, which holds an exclusive
# lock and breaks (silently drops writes) under concurrent access.
# NOTE: the copilot/agents read python-agent/.env, so set QDRANT_HOST there.
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Alternatively a full URL (takes precedence): QDRANT_URL=http://localhost:6333

# Mem0 sidecar — the backend spawns python-agent/utils/mem0_sidecar.py as a
# managed child process at startup and talks to it over HTTP (replacing the old
# per-request CLI spawn). Set ENABLE_MEM0_SIDECAR=false to disable spawning
# (e.g. when the python-agent venv is unavailable).
MEM0_SIDECAR_HOST=127.0.0.1
MEM0_SIDECAR_PORT=8770
# ENABLE_MEM0_SIDECAR=false

# Swarm Copilot — Securelytix PII tokenization. OFF by default: the NER tokenizer
# mistakes public product/agent names (e.g. "DevOps Geni") for PII and tokenizes
# them inconsistently, breaking entity matching between the query and the public
# knowledge base. Set to true only if you need PII tokenization on the copilot path.
# ENABLE_COPILOT_PII_TOKENIZATION=true

