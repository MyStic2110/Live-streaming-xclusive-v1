# Project-wide environment variables (can be used as fallback or consolidated configuration)
# Copy this to .env at the root of the project to load globally.

# LiveKit Configuration
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# OpenRouter / LLM Config
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ENABLE_LLM_TRACING=false

# Shoppe agent — structured price comparison (optional).
# When set, SHOPPE fetches real per-merchant prices (SerpAPI Google Shopping, gl=in)
# and reports the genuine cheapest store. Without it, Shoppe falls back to the
# live browser scrape (no reliable price comparison). NOTE: the Shoppe worker reads
# python-agent/.env, so put SERPAPI_KEY there for the agent at runtime.
SERPAPI_KEY=your_serpapi_key_here

